# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# local directory of output files
/fishery_analyses
/project_outputs
/project_scripts

# RDS file with parameters supplied to analysis-specific render.analysis.R script 
/input_files/params_list.rds

# Database configuration file
config.yml

# Dev container configuration
.devcontainer/
.devcontainer

# Every file in here is regenerable by re-running its producing script (see
# analysis/pst/README.md's directory map - "Nothing here is hand-edited").
# Untracked as of 2026-08-20: local pipeline runs were producing untracked
# copies at the same paths as already-committed files, so `git pull` refused
# to check out ("untracked working tree files would be overwritten by
# checkout" on combined_proportions_*.csv etc. - it would have silently
# clobbered the local copy). To commit a deliberate snapshot anyway (e.g.
# alongside a logic change, as evidence of its effect), force past the
# ignore: `git add -f analysis/pst/outputs/<file>`.
analysis/pst/outputs/

# Local scratch cache (interview_proportions.qmd DB pull; regenerable)
.cache/

# Rendered output of the PST parent doc; regenerable via
# `quarto render analysis/pst/pst_fw_angler_trips.qmd`
analysis/pst/pst_fw_angler_trips.html
